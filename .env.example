# Copy to .env and fill in at least one chat key.
#   cp .env.example .env
#   ./scripts/demo.sh

# At least one required for chat. Multi-agent runs burn Gemini free-tier RPM —
# OpenAI as fallback is strongly recommended.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: default model. Provider is inferred from the name.
# LLM_MODEL=gemini-3-flash-preview
# LLM_FALLBACK_MODEL=gpt-4o

# Written by scripts/load-crew.sh / scripts/demo.sh — do not hand-edit unless
# you know you want a different crew overlay.
# AGENT_CONFIG_DIR=./crews/active/agents
# AGENT_PLUGINS_DIR=./crews/active/tools
# INJECT_COMMON_PROMPTS=false
