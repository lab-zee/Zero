# Server
PORT=3001

# Database
DATABASE_URL=postgresql://labz_user:labz_password@postgres:5432/labz_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=labz_user
POSTGRES_PASSWORD=labz_password
POSTGRES_DB=labz_db

# Default LLM model. Provider is auto-detected from the name:
#   gemini...                 -> Google Gemini (cloud)   [default if unset]
#   contains ":" or ollama/   -> local Ollama proxy      (e.g. qwen3:8b)
#   anything else (gpt-...)   -> OpenAI (cloud)
LLM_MODEL=gemini-3-flash-preview

# Fallback model (OpenAI) used when Gemini returns 503 UNAVAILABLE after retries.
# Requires OPENAI_API_KEY. Defaults to gpt-5.6-luna.
# LLM_FALLBACK_MODEL=gpt-5.6-luna

# LLM API Keys (add your keys here)
# At least one key is required for chat. Embeddings always use OPENAI_API_KEY when
# uploading/searching documents (even if chat uses Gemini or a local model).
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here

# Optional: load a CrewDefine crew via scripts/load-crew.sh (uncomment after loading)
# AGENT_CONFIG_DIR=./crews/active/agents
# AGENT_PLUGINS_DIR=./crews/active/tools
# INJECT_COMMON_PROMPTS=false
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Local model provider (only used when LLM_MODEL is an Ollama tag / ollama/-prefixed)
# LOCAL_LLM_BASE_URL=https://api.labzbrain.com/v1
# LOCAL_LLM_API_KEY=ollama

# File upload directory (defaults to "uploads")
# For Railway, mount a volume to this directory for persistent storage
# IMPORTANT: Railway containers are ephemeral - files will be lost on restart unless you mount a volume
# To use a volume: In Railway, go to your service → Settings → Volumes → Mount a volume to /app/uploads
UPLOAD_DIR=uploads

# OpenAI Model (defaults to gpt-4o for PDF support)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo-preview, etc.
OPENAI_MODEL=gpt-4o

# Rate Limiting (optional - defaults shown)
# OPENAI_TPM_LIMIT=30000  # Tokens per minute limit (default: 30000)
# OPENAI_RPM_LIMIT=500    # Requests per minute limit (optional, no default)